{
  "lineWidth": 100,
  "typescript": { "quoteStyle": "preferSingle", "semiColons": "always" },
  "includes": ["**/*.ts", "*.json", "**/*.mjs", "../docs/agents*.md"],
  "excludes": ["node_modules", "package-lock.json"],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.11.wasm",
    "https://plugins.dprint.dev/json-0.21.0.wasm",
    "https://plugins.dprint.dev/markdown-0.19.0.wasm"
  ]
}
