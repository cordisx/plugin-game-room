{
  "lineWidth": 100,
  "indentWidth": 2,
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "asi"
  },
  "includes": [
    "**/*.{js,mjs,json,md}"
  ],
  "excludes": [
    "node_modules/**",
    "dist/**",
    "package-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.3"
  ]
}
