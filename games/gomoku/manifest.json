{
  "id": "gomoku",
  "version": "1.5.12",
  "name": "五子棋",
  "minPlayers": 2,
  "maxPlayers": 2,
  "modes": [
    "score",
    "local-chips",
    "token"
  ],
  "description": "自由五子棋；支持 9×9、13×13、15×15 棋盘，连成至少五子获胜，超时判负。",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "boardSize": {
        "type": "integer",
        "title": "棋盘大小",
        "enum": [
          9,
          13,
          15
        ],
        "default": 15
      }
    }
  },
  "spectating": true,
  "rulesBot": "rules-bot-v1",
  "waitingUi": true,
  "minimumViewport": {
    "width": 460,
    "height": 520
  }
}
