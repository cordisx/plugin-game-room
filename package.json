{
  "name": "@cordisx/game-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "tsx server/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/server/*.test.ts",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint server sdk tests/server deploy/*.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:production",
    "test:production": "node tests/server/production-smoke.mjs"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@cordisx/eslint-config": "github:cordisx/cordisxmono#32fa3b257cd5a7bfa0bb2d5f1012ca18665d1637",
    "@types/node": "26.5.0",
    "@typescript-eslint/parser": "8.70.0",
    "dprint": "0.57.4",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
