{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "declaration": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "server/**/*.ts",
    "sdk/**/*.ts",
    "tests/server/**/*.ts",
    "sdk/**/*.mjs"
  ]
}
